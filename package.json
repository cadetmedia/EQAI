{
  "name": "eqai",
  "version": "1.0.0-alpha.0",
  "description": "EQAI — a resizable, always-on-top EverQuest overlay that lets you ask an AI about what's on screen (via region capture) or by typing questions.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cadetmedia.eqai",
    "productName": "EQAI",
    "publish": null,
    "icon": "build/icon.ico",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "EQAI"
    },
    "portable": {
      "artifactName": "EQAI-portable-${version}.exe"
    }
  }
}
