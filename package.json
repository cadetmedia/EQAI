{
  "name": "eqai",
  "version": "1.0.0-alpha.15",
  "description": "EQAI — a resizable, always-on-top EverQuest overlay that lets you ask an AI about what's on screen (via region capture) or by typing questions.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.cadetmedia.eqai",
    "productName": "EQAI",
    "publish": {
      "provider": "github",
      "owner": "cadetmedia",
      "repo": "EQAI"
    },
    "icon": "build/icon.ico",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "EQAI",
      "artifactName": "EQAI-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "EQAI-portable-${version}.exe"
    }
  }
}
